# ===========================================
# 教育平台环境变量配置
# ===========================================

# Flask环境
FLASK_ENV=production
FLASK_DEBUG=0

# 数据库配置
DB_HOST=db
DB_PORT=3306
DB_NAME=adult_education
DB_USER=education_user
DB_PASSWORD=Education@2024

# 完整数据库URL（Docker内部使用）
DATABASE_URL=mysql+pymysql://education_user:Education@2024@db:3306/adult_education

# 安全密钥（请修改为随机字符串）
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=jwt-secret-key-change-this-in-production

# 前端API地址
VITE_API_URL=/api

# 文件上传配置
MAX_CONTENT_LENGTH=104857600
UPLOAD_FOLDER=/app/uploads

# 邮件配置（可选）
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-email-password

# 域名配置
DOMAIN=your-domain.com
