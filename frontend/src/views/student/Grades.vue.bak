<template>
  <div class="grades-page">
    <div class="page-container">
      <h4 class="mb-4">我的成绩</h4>

      <div class="card shadow-sm">
        <div class="card-body">
          <el-table :data="grades" style="width: 100%" v-loading="loading">
            <el-table-column prop="course_title" label="课程名称" min-width="150" />
            <el-table-column prop="assignment_title" label="作业名称" min-width="150" />
            <el-table-column label="得分" width="120">
              <template #default="{ row }">
                <span :class="getScoreClass(row.score, row.max_score)">
                  {{ row.score }} / {{ row.max_score }}
                </span>
              </template>
            </el-table-column>
            <el-table-column label="评级" width="100">
              <template #default="{ row }">
                <el-tag :type="getGradeType(row.score, row.max_score)">
                  {{ getGrade(row.score, row.max_score) }}
                </el-tag>
              </template>
            </el-table-column>
            <el-table-column prop="feedback" label="教师评语" min-width="200" show-overflow-tooltip />
            <el-table-column label="批改时间" width="150">
              <template #default="{ row }">
                {{ formatDate(row.graded_at) }}
              </template>
            </el-table-column>
          </el-table>

          <div v-if="grades.length === 0 && !loading" class="text-center py-5">
            <el-icon :size="64" class="text-muted"><Document /></el-icon>
            <p class="text-muted mt-3">暂无成绩记录</p>
          </div>
        </div>
      </div>

      <div class="row mt-4" v-if="grades.length > 0">
        <div class="col-md-4 mb-3">
          <div class="card shadow-sm bg-primary text-white">
            <div class="card-body text-center">
              <h3>{{ avgScore }}</h3>
              <p class="mb-0">平均分</p>
            </div>
          </div>
        </div>
        <div class="col-md-4 mb-3">
          <div class="card shadow-sm bg-success text-white">
            <div class="card-body text-center">
              <h3>{{ highestScore }}</h3>
              <p class="mb-0">最高分</p>
            </div>
          </div>
        </div>
        <div class="col-md-4 mb-3">
          <div class="card shadow-sm bg-info text-white">
            <div class="card-body text-center">
              <h3>{{ grades.length }}</h3>
              <p class="mb-0">已批改作业数</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, onMounted } from 'vue'
import { userApi } from '@/api'
import { ElMessage } from 'element-plus'
import { Document } from '@element-plus/icons-vue'

const grades = ref([])
const loading = ref(false)

const avgScore = computed(() => {
  if (grades.value.length === 0) return 0
  const total = grades.value.reduce((sum, g) => sum + (g.score / g.max_score) * 100, 0)
  return Math.round(total / grades.value.length)
})

const highestScore = computed(() => {
  if (grades.value.length === 0) return 0
  return Math.max(...grades.value.map(g => Math.round((g.score / g.max_score) * 100)))
})

function getGrade(score, maxScore) {
  const percent = (score / maxScore) * 100
  if (percent >= 90) return '优秀'
  if (percent >= 80) return '良好'
  if (percent >= 70) return '中等'
  if (percent >= 60) return '及格'
  return '不及格'
}

function getGradeType(score, maxScore) {
  const percent = (score / maxScore) * 100
  if (percent >= 90) return 'success'
  if (percent >= 80) return 'primary'
  if (percent >= 60) return 'warning'
  return 'danger'
}

function getScoreClass(score, maxScore) {
  const percent = (score / maxScore) * 100
  if (percent >= 90) return 'text-success fw-bold'
  if (percent >= 60) return ''
  return 'text-danger fw-bold'
}

function formatDate(dateStr) {
  if (!dateStr) return '-'
  return new Date(dateStr).toLocaleDateString('zh-CN')
}

onMounted(async () => {
  loading.value = true
  try {
    const res = await userApi.getGrades()
    grades.value = res.data.grades
  } catch (e) {
    ElMessage.error('获取成绩失败')
  } finally {
    loading.value = false
  }
})
</script>
